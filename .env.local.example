# Configuration Firebase du site Garage Concept.
# Copiez ce fichier en `.env.local` puis remplissez chaque valeur avec la
# configuration web de votre projet Firebase (console.firebase.google.com >
# Parametres du projet > Vos applications > Application Web > SDK setup).
# `.env.local` n'est jamais commite (voir .gitignore).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Avis Google de la fiche etablissement (scene 04 « Ils nous font confiance »).
# Ces deux variables sont volontairement SANS prefixe NEXT_PUBLIC_ : la cle ne
# doit jamais partir dans le bundle navigateur, elle n'est lue qu'au build par
# `src/lib/googleReviews.ts` (Server Component uniquement).
# - GOOGLE_PLACES_API_KEY : console.cloud.google.com > APIs & Services >
#   activez « Places API » puis Identifiants > Creer des identifiants > Cle API.
# - GOOGLE_PLACE_ID : identifiant de la fiche, via l'outil « Place ID Finder »
#   de Google (developers.google.com/maps/documentation/places/web-service/place-id)
#   ou depuis la fiche Google Business de l'etablissement.
# Tant que l'une des deux est vide, le site affiche les temoignages de
# demonstration de `src/lib/garageInfo.ts`.
# ATTENTION : le site est exporte en statique (`output: "export"`), les avis
# sont donc figes dans le HTML au moment du build. Il faut relancer un
# `npm run build` et un deploiement pour que de nouveaux avis apparaissent :
# il n'y a aucun rafraichissement en direct.

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
